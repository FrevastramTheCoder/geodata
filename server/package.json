{
  "name": "geodata-hub-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js && node scripts/seed-software.js",
    "db:seed:software": "node scripts/seed-software.js",
    "db:studio": "prisma studio",
    "ingest": "node scripts/ingest.js",
    "ingest:nbs": "node scripts/ingest.js nbs",
    "ingest:all": "node scripts/ingest.js all",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.2",
    "robots-parser": "^3.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1"
  }
}
