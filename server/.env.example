DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/geodata_hub"
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# NBS connector politeness
NBS_RATE_LIMIT_MS=1500
NBS_USER_AGENT="TanzaniaGeoDataHub/1.0 (+https://geodatahub.example; contact: admin@example.com)"

# Session signing (use a long random value in production)
SESSION_SECRET="replace-with-a-long-random-secret"

# Bootstrap roles for existing/new Google accounts. Comma-separated emails.
SUPER_ADMIN_EMAILS=""
ADMIN_EMAILS=""

# Google OAuth (the ID-token audience is verified server-side)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
