generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dataset {
  id                 String           @id @default(cuid())
  name               String
  slug               String?          @unique
  description        String?
  categoryId         String?
  category           Category?        @relation(fields: [categoryId], references: [id])
  coverage           String?
  country            String?          @default("Tanzania")
  region             String?
  sourceId           String?
  source             Source?          @relation(fields: [sourceId], references: [id])
  year               Int?
  dataType           String?
  format             String?
  resolution         String?
  crs                String?
  license            String?
  accessType         String           @default("PUBLIC_DOWNLOAD") // PUBLIC_DOWNLOAD | DIRECT_DOWNLOAD | REQUEST | VIEW
  officialUrl        String
  directUrl          String?
  lastVerified       DateTime?
  verificationStatus String           @default("UNKNOWN") // VERIFIED | BROKEN | REDIRECTED | RESTRICTED | REQUEST_REQUIRED | UNKNOWN
  views              Int              @default(0)
  status             String           @default("DISCOVERED") // DISCOVERED | PENDING_REVIEW | APPROVED | PUBLISHED | REJECTED | BROKEN_LINK | ARCHIVED
  sourceUrl          String? // page the record was discovered from
  tags               String[]
  popular            Boolean          @default(false)
  isLocal            Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  ingestRunId        String?
  sourceRecordKey    String?          @unique // dedup key (source slug + stable id)
  submissionId       String?          @unique
  submission         Submission?      @relation(fields: [submissionId], references: [id])
  favorites          Favorite[]       @relation("DatasetFavorites")
  recentlyViewed     RecentlyViewed[] @relation("DatasetRecentlyViewed")
  activityLogs       ActivityLog[]    @relation("DatasetActivity")

  @@index([status])
  @@index([categoryId])
  @@index([sourceId])
  @@index([country])
  @@index([year])
  @@index([accessType])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String?
  color       String?
  sortOrder   Int       @default(0)
  datasets    Dataset[]
}

model Source {
  id           String               @id @default(cuid())
  slug         String               @unique
  name         String
  shortName    String?
  description  String?
  websiteUrl   String?
  country      String               @default("Tanzania")
  type         String               @default("Government") // Government | International | NGO | Research | Commercial
  logoUrl      String?
  featured     Boolean              @default(false)
  lastVerified DateTime?
  datasets     Dataset[]
  adminAreas   AdministrativeArea[]
}

model Submission {
  id             String   @id @default(cuid())
  name           String
  description    String?
  category       String?
  coverage       String?
  source         String?
  year           Int?
  dataType       String?
  format         String?
  resolution     String?
  license        String?
  officialUrl    String
  directUrl      String?
  submitterName  String?
  submitterEmail String?
  status         String   @default("PENDING_REVIEW")
  notes          String?
  userId         String?
  submitter      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  dataset        Dataset?

  @@index([userId])
  @@index([status])
}

model IngestRun {
  id          String    @id @default(cuid())
  source      String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String    @default("RUNNING") // RUNNING | COMPLETED | FAILED
  discovered  Int       @default(0)
  updated     Int       @default(0)
  created     Int       @default(0)
  duplicates  Int       @default(0)
  brokenLinks Int       @default(0)
  parseErrors Int       @default(0)
  log         Json?
}

model IngestLog {
  id        String   @id @default(cuid())
  runId     String?
  level     String // INFO | WARN | ERROR
  message   String
  datasetId String?
  createdAt DateTime @default(now())
}

model User {
  id                 String              @id @default(cuid())
  googleId           String              @unique
  name               String
  email              String              @unique
  avatarUrl          String?
  role               String              @default("USER") // USER | ADMIN | SUPER_ADMIN
  status             String              @default("ACTIVE") // ACTIVE | SUSPENDED | DELETED
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lastLoginAt        DateTime?
  activityLogs       ActivityLog[]
  favorites          Favorite[]
  recentlyViewed     RecentlyViewed[]
  submissions        Submission[]
  enrollments        Enrollment[]
  lessonProgress     LessonProgress[]
  certificates       Certificate[]
  projectSubmissions ProjectSubmission[]

  @@index([email])
  @@index([googleId])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@index([lastLoginAt])
}

model AdministrativeArea {
  id             String               @id @default(cuid())
  name           String
  officialName   String?
  code           String?
  level          String // GLOBAL | COUNTRY | REGION | DISTRICT | COUNCIL | WARD | SHEHIA | VILLAGE | MTAA | SUB_WARD | HAMLET | ENUMERATION_AREA
  parentId       String?
  parent         AdministrativeArea?  @relation("AdminAreaTree", fields: [parentId], references: [id])
  children       AdministrativeArea[] @relation("AdminAreaTree")
  country        String?              @default("Tanzania")
  region         String?
  district       String?
  ward           String?
  sourceId       String?
  source         Source?              @relation(fields: [sourceId], references: [id])
  sourceUrl      String?
  accessUrl      String?
  year           Int?
  version        String?
  geometry       Json?
  status         String               @default("DISCOVERED") // DISCOVERED | VERIFIED | REQUEST_REQUIRED | ARCHIVED
  lastVerifiedAt DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([level])
  @@index([parentId])
  @@index([country])
  @@index([code])
}

model Software {
  id                 String            @id @default(cuid())
  name               String
  slug               String            @unique
  description        String
  developerId        String?
  developer          Developer?        @relation(fields: [developerId], references: [id])
  categoryId         String?
  category           SoftwareCategory? @relation(fields: [categoryId], references: [id])
  licenseType        String            @default("COMMERCIAL") // FREE | OPEN_SOURCE | FREEMIUM | EDUCATIONAL | COMMERCIAL | TRIAL
  pricing            String? // display text, e.g. "Free", "Subscription", "Free tier + paid plans"
  operatingSystems   String[] // Windows | macOS | Linux | Web | Android | iOS
  technology         String[] // GIS | CAD | BIM | Remote Sensing | GeoAI | 3D | Surveying | Planning | Data Science
  version            String?
  officialWebsite    String
  downloadUrl        String?
  documentationUrl   String?
  tutorialUrl        String?
  systemRequirements String?
  keywords           String[]
  logoUrl            String?
  verificationStatus String            @default("UNKNOWN") // VERIFIED | BROKEN | REDIRECTED | UNKNOWN
  lastVerifiedAt     DateTime?
  views              Int               @default(0)
  status             String            @default("PENDING_REVIEW") // DRAFT | PENDING_REVIEW | PUBLISHED | REJECTED | BROKEN
  hasGIS             Boolean           @default(false)
  hasRemoteSensing   Boolean           @default(false)
  has3D              Boolean           @default(false)
  hasCAD             Boolean           @default(false)
  hasBIM             Boolean           @default(false)
  hasWeb             Boolean           @default(false)
  hasDatabase        Boolean           @default(false)
  hasPython          Boolean           @default(false)
  studentAccess      Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  favorites          Favorite[]        @relation("SoftwareFavorites")
  recentlyViewed     RecentlyViewed[]  @relation("SoftwareRecentlyViewed")
  activityLogs       ActivityLog[]     @relation("SoftwareActivity")

  @@index([status])
  @@index([verificationStatus])
  @@index([categoryId])
  @@index([developerId])
  @@index([licenseType])
}

model SoftwareCategory {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  sortOrder   Int        @default(0)
  software    Software[]
}

model Developer {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  website     String?
  description String?
  software    Software[]
}

model SoftwareSubmission {
  id              String   @id @default(cuid())
  name            String
  officialWebsite String
  downloadUrl     String?
  category        String?
  description     String?
  submitterName   String?
  submitterEmail  String?
  status          String   @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | REJECTED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

model ActivityLog {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       String
  resourceType String?
  resourceId   String?
  datasetId    String?
  dataset      Dataset?  @relation("DatasetActivity", fields: [datasetId], references: [id], onDelete: SetNull)
  softwareId   String?
  software     Software? @relation("SoftwareActivity", fields: [softwareId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, resourceId])
  @@index([datasetId])
  @@index([softwareId])
}

model Favorite {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceType  String
  resourceId    String
  datasetId     String?
  dataset       Dataset?     @relation("DatasetFavorites", fields: [datasetId], references: [id], onDelete: Cascade)
  softwareId    String?
  software      Software?    @relation("SoftwareFavorites", fields: [softwareId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation("OpportunityFavorites", fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@unique([userId, resourceType, resourceId])
  @@index([userId, createdAt])
  @@index([datasetId])
  @@index([softwareId])
  @@index([opportunityId])
}

model RecentlyViewed {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceType String
  resourceId   String
  datasetId    String?
  dataset      Dataset?  @relation("DatasetRecentlyViewed", fields: [datasetId], references: [id], onDelete: Cascade)
  softwareId   String?
  software     Software? @relation("SoftwareRecentlyViewed", fields: [softwareId], references: [id], onDelete: Cascade)
  viewedAt     DateTime  @default(now())

  @@unique([userId, resourceType, resourceId])
  @@index([userId, viewedAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  subject   String
  message   String
  status    String   @default("UNREAD") // UNREAD | READ | ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Course {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  title                String
  description          String
  instructor           String
  category             String
  level                String
  duration             String
  preview              String?
  learningObjectives   String[]
  certificateAvailable Boolean            @default(false)
  status               String             @default("PUBLISHED")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  lessons              Lesson[]
  enrollments          Enrollment[]
  assignments          Assignment[]
  materials            TrainingMaterial[]
  certificates         Certificate[]

  @@index([status])
  @@index([category])
}

model Lesson {
  id          String             @id @default(cuid())
  courseId    String
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  content     String?
  orderNumber Int
  duration    String?
  isPreview   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  progress    LessonProgress[]
  materials   TrainingMaterial[]
  assignments Assignment[]

  @@unique([courseId, orderNumber])
  @@index([courseId, orderNumber])
}

model TrainingMaterial {
  id        String  @id @default(cuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId  String?
  lesson    Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title     String
  type      String
  url       String
  protected Boolean @default(true)

  @@index([courseId])
  @@index([lessonId])
}

model Assignment {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId    String?
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title       String
  description String?
  createdAt   DateTime @default(now())

  @@index([courseId])
  @@index([lessonId])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([userId, updatedAt])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime?

  @@unique([userId, lessonId])
  @@index([userId, completedAt])
}

model Certificate {
  id              String   @id @default(cuid())
  certificateId   String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor      String
  completionDate  DateTime
  issuer          String
  verificationUrl String?
  createdAt       DateTime @default(now())

  @@index([userId, completionDate])
  @@index([courseId])
}

model Opportunity {
  id           String     @id @default(cuid())
  title        String
  category     String
  organization String?
  description  String?
  url          String
  deadline     DateTime?
  status       String     @default("PUBLISHED")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  favorites    Favorite[] @relation("OpportunityFavorites")

  @@index([category, status])
  @@index([createdAt])
}

model ProjectSubmission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  projectUrl  String?
  category    String?
  status      String   @default("PENDING_REVIEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}
